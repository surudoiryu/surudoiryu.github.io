# Browser-visible Firebase web-app configuration (not a server secret)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_DATABASE_URL=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Non-secret browser configuration
REACT_APP_ENABLE_NATIVE_SHARE=false
REACT_APP_GTM_ID=
REACT_APP_GRAPHQL_HOST=
REACT_APP_GRAPHQL_PATH=/graphql

# Server/sync-worker only. Never prefix these with REACT_APP_.
GRAPHQL_ENDPOINT=
# GRAPHQL_AUTH_TOKEN and GRAPHQL_API_KEY belong in Secret Manager, not this file.

# SSR runtime (prefer workload identity over a service-account key)
FIREBASE_PROJECT_ID=
PUBLIC_SITE_ORIGIN=https://weedinfo.nl
PUBLIC_GENERATION_POINTER_TTL_MS=1000
