rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isOwnReviewId(reviewId) {
      return isSignedIn() && reviewId.matches("^" + request.auth.uid + "_.*$");
    }

    // Catalog data: alleen lezen vanuit client, schrijven via worker/service account.
    match /Producten/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Brands/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Shops/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Terpenes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Tastes/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Effects/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /SyncStatus/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /Categories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /SubCategories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Route statistieken (anonieme teller).
    match /Stats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /ViewStats/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User profile: ingelogde gebruikers kunnen lezen, alleen eigen profiel schrijven.
    match /Gebruikers/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // Reviews: direct client write toegestaan voor ingelogde user (eigen review).
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
